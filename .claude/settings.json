{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npx vitest:*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:authjs.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose stop:*)",
      "Bash(npx prisma studio)",
      "Bash(npx prisma migrate status)",
      "WebFetch(domain:next-auth.js.org)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx create-*:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr:*)",
      "Edit(package.json)",
      "Edit(prisma/schema.prisma)",
      "Edit(.github/**)",
      "Edit(.claude/settings.json)",
      "Edit(src/proxy.ts)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(prisma/migrations/**)",
      "Edit(docs/design/source/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push --force-reset:*)",
      "Read(**/*.pem)"
    ]
  }
}
